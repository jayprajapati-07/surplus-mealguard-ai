DATABASE_URL="file:./dev.db"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
SESSION_TTL_HOURS=72
RATE_LIMIT_AUTH_MAX=30
NODE_ENV="development"

# Supabase Project Configuration (optional — leave blank for local-only mode)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Optional direct Supabase PostgreSQL connection URI (replace [YOUR-PASSWORD] with your Supabase database password)
# When connecting Prisma directly to Supabase Postgres, update schema.prisma provider to "postgresql":
# SUPABASE_DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.xewlimzaswophixqwogi.supabase.co:5432/postgres"

# Optional SMTP for NGO email delivery (when absent, simulated in Development Mailbox)
#SMTP_HOST=""
#SMTP_PORT=587
#SMTP_SECURE=false
#SMTP_USER=""
#SMTP_PASS=""
#SMTP_FROM="mealguard@localhost"

# Resend email provider (takes priority over SMTP when set).
# Needs a verified sender: RESEND_FROM must be an onboarding@resend.dev
# address (delivers to your own account email only) or an address on a
# domain you verified at resend.com/domains. Gmail-only users should use
# SMTP above (smtp.gmail.com + an App Password) for real NGO delivery.
#RESEND_API_KEY=""
#RESEND_FROM=""
# Live email in automated tests is always disabled (simulated) unless set:
#MAIL_LIVE_TEST="1"

# NGO discovery uses keyless OpenStreetMap services (Nominatim + Overpass) —
# no API key needed. Keep usage polite: discovery runs bounded queries only.

# Gemini AI for historical Excel structure understanding (server-only; never expose to frontend).
# When blank, imports use deterministic column detection and onboarding never blocks.
#GEMINI_API_KEY=""
