# Root environment configuration
# Server reads server/.env; Client reads client/.env
# Copy values into server/.env and client/.env — never commit real secrets.

# Client API base (defaults to http://localhost:4000/api)
VITE_API_URL=http://localhost:4000/api

# Supabase Project Configuration (optional — leave blank for local-only mode)
# Get these from Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
